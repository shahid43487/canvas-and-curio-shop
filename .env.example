# Names actually read by app/config source; placeholders only, no real credentials.
# Configure your own deployment; never copy this into committed secret-bearing files.
# Other managed secret names not referenced by current app source are listed in PROJECT_CONTEXT.md context, not required here.

# Public browser backend endpoint; set at build time.
VITE_SUPABASE_URL=https://your-backend.example

# Public browser API key from your own backend; not a private server key.
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_public_api_key

# Server backend endpoint; inject into the runtime.
SUPABASE_URL=https://your-backend.example

# Server public API key for public and user-scoped reads.
SUPABASE_PUBLISHABLE_KEY=replace_with_public_api_key

# Private privileged backend credential; server runtime only, never expose via VITE_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_own_backend_private_key

# Private admin access/signing secret; provision securely, rotation invalidates signed tokens.
ADMIN_TOKEN=replace_with_secure_admin_signing_secret

# Configured admin login identifier; current shared login dispatch requires an @admin suffix.
ADMIN_LOGIN_EMAIL=yourname@admin

# Private admin login password; set securely in the runtime secret manager.
ADMIN_LOGIN_PASSWORD=replace_with_private_admin_password

# Optional private schedule verifier used by the cron-auth helper.
LOVABLE_CRON_SECRET=replace_if_using_scheduled_requests

# Optional previous cron verifier during rotation; omit when unused.
LOVABLE_CRON_SECRET_PREVIOUS=replace_only_during_cron_rotation

# Private privileged migration connection read by drizzle.config.ts; Lovable tool supplies it in managed execution.
LOVABLE_DB_MIGRATION_URL=replace_with_your_own_private_migration_connection
